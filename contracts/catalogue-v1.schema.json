{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VeVarunSharma/babazon-catalogue-service/main/contracts/catalogue-v1.schema.json",
  "title": "Babazon catalogue HTTP responses v1",
  "description": "Service-owned browse/detail starter contract. Search and category filtering are not implemented. See README.md for endpoint, query, and status-code rules.",
  "oneOf": [
    { "$ref": "#/$defs/ProductListResponse" },
    { "$ref": "#/$defs/ProductDetailResponse" },
    { "$ref": "#/$defs/HealthResponse" },
    { "$ref": "#/$defs/ReadyResponse" },
    { "$ref": "#/$defs/ApiError" }
  ],
  "$defs": {
    "ProductCategory": {
      "type": "string",
      "enum": ["home", "outdoors", "office", "kitchen"]
    },
    "Product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "shortDescription", "description", "category",
        "priceCents", "rating", "reviewCount", "availability", "features", "accent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/ProductCategory" },
        "priceCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "reviewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "availability": { "type": "string", "enum": ["in-stock", "limited"] },
        "badge": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "accent": { "type": "string", "minLength": 1 }
      }
    },
    "ProductListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "total", "query", "categories"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/Product" } },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["q"],
          "properties": { "q": { "type": "string", "const": "" } }
        },
        "categories": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ProductCategory" }
        }
      }
    },
    "ProductDetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": { "product": { "$ref": "#/$defs/Product" } }
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "type": "string", "const": "ok" } }
    },
    "ReadyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "type": "string", "const": "ready" } }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR", "UNSUPPORTED_QUERY", "NOT_FOUND",
                "NOT_READY", "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "fieldErrors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
